PORT="Add http server port"
NODE_ENV=dev,prod,test
PROJECT_NAME="Add project name" e.g. 19_...
DEBUG="Add debug namespace" e.g. 19...*
SALT_ROUND="Add salt round for bcrypt (e.g. 12)"
JWT_SECRET=Add a long and random string for JWT secret (e.g. GfyExNXJRPaB/iMOoLevTQzisg+FHfmamnwbMsqiKBY=)
PGUSER=user (e.g postgres)
PGPASSWORD=password
PGHOST=Host (e.g. localhost)
PGPORT=Port (e.g. 5432)
PGDATABASE=db name (e.g. films_db)
DATABASE_URL=suma de los anteriores

Crea los ficheros .env y .env.test a partir de este .env.sample, 
rellenando los valores necesarios para cada entorno.


// .env:
PORT=3000
NODE_ENV=dev
PROJECT_NAME="19_Films_API"
DEBUG="19_films:*"
SALT_ROUND=12
JWT_SECRET=GfyExNXJRPaB/iMOoLevTQzisg+FHfmamnwbMsqiKBY=

# Configuración de base de datos para TU Docker
PGUSER=postgres
PGPASSWORD=clase
PGHOST=localhost
PGPORT=5434
PGDATABASE=films_db
DATABASE_URL="postgresql://postgres:Curso_@2026@localhost:5434/films_db?schema=public"

// .env.test:
PORT=3001
NODE_ENV=test
PROJECT_NAME="19_Films_API_Test"
DEBUG="19_films:test:*"
SALT_ROUND=12
JWT_SECRET=GfyExNXJRPaB/iMOoLevTQzisg+FHfmamnwbMsqiKBY=

PGUSER=postgres
PGPASSWORD=clase
PGHOST=localhost
PGPORT=5432
PGDATABASE=films_test_db
DATABASE_URL="postgresql://postgres:clase@localhost:5432/films_test_db?schema=public"

